# PostgreSQL credentials used by docker-compose
PG_HOST=postgres
PG_PORT=5432
PG_USER=airflow
PG_PASSWORD=your_postgres_password_here
PG_DB=airflow

# Airflow webserver/admin credentials
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=your_airflow_password_here
AIRFLOW_EMAIL=admin@example.com
AIRFLOW_FIRSTNAME=Admin
AIRFLOW_LASTNAME=User
AIRFLOW_ROLE=Admin

# Airflow Configuration
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:your_postgres_password_here@postgres:5432/airflow

AIRFLOW__WEBSERVER__RBAC=True
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth

# API Keys (Replace these placeholders with your actual keys)
PRODUCT_HUNT_KEY=your_product_hunt_api_key_here
COMPANY_HOUSE_KEY=your_company_house_api_key_here
COMPANIESAPI_KEY=your_companies_api_key_here

# Company enrichment (netlify/functions/company.mts)
# Local only - production values are set with `netlify env:set`, not read from here.
# Whichever key is present wins, Anthropic first; ENRICH_PROVIDER forces one.
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=
# ENRICH_PROVIDER=groq
# ENRICH_DAILY_MISS_CAP=200
# ENRICH_IP_PER_MIN=5
